# Nomarr dev environment variables.
# Used by docker-compose.dev.yaml — NOT for production.

# PostgreSQL connection (service name on the internal Docker Compose network)
DATABASE_URL=postgresql+asyncpg://nomarr:nomarr@nomarr-postgres:5432/nomarr
DATABASE_URL_SYNC=postgresql+psycopg2://nomarr:nomarr@nomarr-postgres:5432/nomarr
