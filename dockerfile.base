# ----------------------------------------------------------------------
#  Nomarr Base Image - Heavy dependencies only
#  Build once, reuse for all app builds
#  Last rebuild: 2026-06-18 (added libchromaprint1 + pyacoustid for audio fingerprinting;
#  historical — the Python dependency set is now derived from pyproject.toml + uv.lock).
# ----------------------------------------------------------------------

# ==============================================================
#  Runtime image
#  nvidia/cuda cudnn-runtime variant includes cuBLAS + cuDNN — required by
#  onnxruntime-gpu's CUDA EP (the provider plugin does NOT bundle them).
#  The NVIDIA Container Runtime injects libcuda.so.1 (driver) at run time.
# ==============================================================
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    LC_ALL=C.UTF-8 LANG=C.UTF-8 \
    PYTHONPATH=/usr/local/lib/python3/dist-packages

# No project virtual environment is configured: the Essentia waf prefix is left
# unset so it installs into the system Python, and the production set is
# exact-synced directly into the Ubuntu 24.04 system Python 3.12 (no .venv,
# no managed CPython).

# ----------------------------------------------------------------------
#  System packages — Python 3.12 (default on 24.04), audio/media libs
#  libsndfile1: soundfile backend (FLAC/OGG/WAV) — kept as fallback
#  ffmpeg + libav*: runtime libs for essentia AudioLoader (MP3/M4A/AAC/FLAC/etc)
#  libsamplerate0: runtime lib for essentia Resample algorithm
#  libfftw3-single3: runtime lib for essentia FFT/Spectrum (libfftw3f.so.3)
#  sox: general audio utility (optional but kept for diagnostics)
#  --- Build-only (purged after essentia compile) ---
#  g++ pkg-config python3-dev: waf C++ build
#  libav*-dev libsamplerate0-dev: header files for essentia compilation
# ----------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-dev libpython3.12t64 \
        cron libsndfile1 ffmpeg sox ca-certificates curl tini \
        libsamplerate0 libsamplerate0-dev libfftw3-single3 \
        libchromaprint1 \
        g++ pkg-config git \
        libeigen3-dev libfftw3-dev \
        libavcodec-dev libavformat-dev libavutil-dev libswresample-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# ----------------------------------------------------------------------
#  Python packages — uv is the sole package/environment manager for this
#  image. uv is pinned (no unbounded `latest`). The production GPU / no-dev
#  set is derived from pyproject.toml + uv.lock and exact-synced into the
#  existing system Python (Ubuntu 24.04 / PEP 668-safe). The requirements
#  export exists only transiently inside the single RUN below — there is no
#  committed generated manifest.
#  `--no-default-groups` is REQUIRED: `--group gpu` ADDS to the default
#  {dev, cpu} groups, which would also install the CPU ONNX fork and dev tools.
#  `--python /usr/bin/python3` + UV_PYTHON_DOWNLOADS=never forbid a managed
#  CPython download (R11).
# ----------------------------------------------------------------------
COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /uvx /bin/

WORKDIR /tmp/nomarr-deps
COPY pyproject.toml uv.lock .python-version ./

RUN uv export --frozen --no-default-groups --group gpu \
        --no-emit-project --no-hashes \
        --python /usr/bin/python3 \
        -o /tmp/nomarr-gpu-requirements.txt && \
    uv pip sync --system --break-system-packages --dry-run \
        /tmp/nomarr-gpu-requirements.txt && \
    uv pip sync --system --break-system-packages \
        /tmp/nomarr-gpu-requirements.txt && \
    rm -rf /tmp/nomarr-deps /tmp/nomarr-gpu-requirements.txt

# ----------------------------------------------------------------------
#  Build essentia — minimal: AudioLoader + MonoLoader + MonoMixer +
#  Resample + FrameCutter (FrameCutter required by waf Python bindings check)
#  No TF, no Vamp, no examples, no tests.
#  AudioLoader has crash-hardening patches applied (build_resources/essentia).
#  The waf prefix env is left unset so essentia lands in the system Python.
#  The exact sync above is the ONLY one: no further exact synchronization runs
#  after this build (essentia is intentionally absent from the lock).
# ----------------------------------------------------------------------
COPY build_resources/essentia/ /tmp/essentia/
RUN cd /tmp/essentia && \
    python3 waf configure \
        --with-python \
        --no-msse \
        --include-algos=AudioLoader,MonoLoader,MonoMixer,Resample,FrameCutter,FileOutputProxy,FFT,Magnitude,NoiseAdder,Windowing,Spectrum,TriangularBands,MelBands,UnaryOperator \
    && python3 waf \
    && python3 waf install \
    && ldconfig \
    && cd / && rm -rf /tmp/essentia

# Purge build-only packages (runtime libs libsamplerate0, libfftw3-single3 + libav* remain via ffmpeg)
RUN apt-get purge -y g++ pkg-config git python3-dev \
        libeigen3-dev libfftw3-dev \
        libavcodec-dev libavformat-dev libavutil-dev libswresample-dev \
        libsamplerate0-dev \
    && apt-get autoremove -y \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Sanity checks — the LAST RUN. Prove the compiled Essentia, chromaprint, and the
# CUDA onnxruntime-gpu distribution resolve, and log the resolved file paths for
# R15 evidence. No exact sync may follow the waf install above.
RUN python3 -c "import importlib.metadata as m, onnxruntime as ort; assert m.version('onnxruntime-gpu'); p=ort.get_available_providers(); assert 'CUDAExecutionProvider' in p, p; print('onnxruntime-gpu', m.version('onnxruntime-gpu'), p)" \
    && python3 -c "import essentia; import essentia.standard as es; es.MonoLoader; print('essentia:', essentia.__version__, '| file:', essentia.__file__, '| MonoLoader: ok')" \
    && python3 -c "import chromaprint; f=chromaprint.Fingerprinter(); f.start(44100,1); f.feed(b'\x00'*4096); fp=f.finish(); print('chromaprint:', len(fp), 'chars | file:', chromaprint.__file__)" \
    && python3 -c "import sys; print('sys.path:', sys.path)"

WORKDIR /app
